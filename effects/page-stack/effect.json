    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer",
        "es": "Reaccionar al puntero",
        "pt-BR": "Reagir ao ponteiro",
        "de": "Auf den Zeiger reagieren",
        "zh-CN": "响应指针",
        "fr": "Réagir au pointeur",
        "ja": "ポインターに反応"
      },
      "default": true,
      "hint": {
        "ru": "Листы слегка смещаются за указателем, ближний к нему приподнимается, а щелчок переворачивает его, как страницу",
        "en": "The sheets shift gently towards the pointer, the nearest one lifts, and a click turns it over like a page",
        "es": "Las hojas se desplazan suavemente hacia el puntero, la más cercana se eleva y un clic la voltea como una página",
        "pt-BR": "As folhas se deslocam suavemente em direção ao ponteiro, a mais próxima se ergue e um clique a vira como uma página",
        "de": "Die Blätter folgen sanft dem Zeiger, das nächste hebt sich, und ein Klick wendet es wie eine Seite",
        "zh-CN": "纸页随指针轻轻移动，最近的一张会抬起，点击即可像翻书一样把它翻过来",
        "fr": "Les feuilles suivent doucement le pointeur, la plus proche se soulève et un clic la retourne comme une page",
        "ja": "紙がポインターの方へゆっくり動き、いちばん近い一枚が持ち上がり、クリックするとページのようにめくれます"
      }
