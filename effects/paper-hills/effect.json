{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "paper-hills",
  "version": "1.0.0",
  "label": {
    "ru": "Бумажные холмы",
    "en": "Paper hills"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "product"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Число слоёв",
        "en": "Layers"
      },
      "default": 6,
      "min": 3,
      "max": 8
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Насыщенность",
        "en": "Strength"
      },
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "mood",
      "type": "choice",
      "label": {
        "ru": "Настроение",
        "en": "Mood"
      },
      "default": "day",
      "options": [
        {
          "value": "dawn",
          "label": {
            "ru": "Рассвет",
            "en": "Dawn"
          }
        },
        {
          "value": "day",
          "label": {
            "ru": "День",
            "en": "Day"
          }
        },
        {
          "value": "mist",
          "label": {
            "ru": "Туман",
            "en": "Mist"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    },
    {
      "key": "scheme",
      "type": "choice",
      "label": {
        "ru": "Тема области",
        "en": "Area theme"
      },
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": {
            "ru": "Светлая",
            "en": "Light"
          }
        }
      ],
      "hint": {
        "ru": "Эффект рисует светлый фон в любой теме страницы; область эффекта получает класс theme-light, и текст над ним берёт роли этой темы.",
        "en": "The effect draws a light ground in any page theme; its area takes theme-light, so text over it uses that theme's roles."
      }
    }
  ],
  "needs": {
    "network": false
  }
}
