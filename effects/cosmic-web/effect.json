{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "cosmic-web",
  "version": "0.1.0",
  "label": {
    "ru": "Космическая паутина",
    "en": "Cosmic web"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "section",
    "dashboard",
    "sign-in"
  ],
  "schemes": [
    "dark"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость",
        "en": "Intensity"
      },
      "default": 70,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "scale",
      "type": "integer",
      "label": {
        "ru": "Масштаб",
        "en": "Scale"
      },
      "default": 40,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "hint": {
        "ru": "Мелкая или крупная сеть",
        "en": "A fine web or a large one"
      }
    },
    {
      "key": "palette",
      "type": "choice",
      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "cyan",
      "options": [
        {
          "value": "cyan",
          "label": {
            "ru": "Бирюзовая",
            "en": "Turquoise"
          }
        },
        {
          "value": "fire",
          "label": {
            "ru": "Огненная",
            "en": "Fire"
          }
        },
        {
          "value": "theme",
          "label": {
            "ru": "Цвет темы",
            "en": "Theme colour"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Указатель притягивает вещество, клик зажигает звезду",
        "en": "The pointer draws matter to itself; a click lights a star"
      }
    }
  ],
  "needs": {
    "network": false
  }
}
