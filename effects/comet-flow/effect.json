{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "comet-flow",
  "version": "1.0.0",
  "label": {
    "ru": "Кометные потоки",
    "en": "Comet flow"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section",
    "dashboard"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 55,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "trail",
      "type": "integer",
      "label": {
        "ru": "Длина следа",
        "en": "Trail length"
      },
      "default": 70,
      "min": 20,
      "max": 95,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "turbulence",
      "type": "integer",
      "label": {
        "ru": "Завихрённость",
        "en": "Turbulence"
      },
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Указатель закручивает поток",
        "en": "The pointer stirs a vortex"
      }
    },
    {
      "key": "scheme",
      "type": "choice",
      "label": {
        "ru": "Тема области",
        "en": "Area theme"
      },
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": {
            "ru": "Тёмная",
            "en": "Dark"
          }
        }
      ],
      "hint": {
        "ru": "Эффект рисует тёмный фон в любой теме страницы; область эффекта получает класс theme-dark, и текст над ним берёт роли этой темы.",
        "en": "The effect draws a dark ground in any page theme; its area takes theme-dark, so text over it uses that theme's roles."
      }
    }
  ],
  "needs": {
    "network": false
  }
}
