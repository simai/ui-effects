{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "glyph-tide",
  "version": "2.0.0",
  "label": {
    "ru": "Знаковый прилив",
    "en": "Glyph tide"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section",
    "dashboard"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 55,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "hint": {
        "ru": "Доля заполненных ячеек",
        "en": "Share of filled cells"
      }
    },
    {
      "key": "charset",
      "type": "choice",
      "label": {
        "ru": "Текст",
        "en": "Text"
      },
      "default": "hex",
      "options": [
        {
          "value": "javascript",
          "label": {
            "ru": "JavaScript",
            "en": "JavaScript"
          }
        },
        {
          "value": "html",
          "label": {
            "ru": "HTML и CSS",
            "en": "HTML and CSS"
          }
        },
        {
          "value": "terminal",
          "label": {
            "ru": "Терминал",
            "en": "Terminal"
          }
        },
        {
          "value": "easter",
          "label": {
            "ru": "С секретами",
            "en": "With secrets"
          }
        },
        {
          "value": "prose",
          "label": {
            "ru": "Слова",
            "en": "Words"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой текст",
            "en": "Own text"
          }
        },
        {
          "value": "letters",
          "label": {
            "ru": "Буквы и цифры",
            "en": "Letters and digits"
          }
        },
        {
          "value": "hex",
          "label": {
            "ru": "Шестнадцатеричные",
            "en": "Hexadecimal"
          }
        },
        {
          "value": "binary",
          "label": {
            "ru": "Двоичные",
            "en": "Binary"
          }
        },
        {
          "value": "digits",
          "label": {
            "ru": "Цифры",
            "en": "Digits"
          }
        },
        {
          "value": "signs",
          "label": {
            "ru": "Знаки",
            "en": "Signs"
          }
        }
      ]
    },
    {
      "key": "text",
      "type": "text",
      "label": {
        "ru": "Свой текст",
        "en": "Own text"
      },
      "default": "",
      "max": 600,
      "hint": {
        "ru": "Для варианта «Свой текст»: фразы через точку или с новой строки",
        "en": "For «Own text»: sentences, or one per line"
      }
    },
    {
      "key": "language",
      "type": "choice",
      "label": {
        "ru": "Язык слов",
        "en": "Words language"
      },
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "ru": "Как у страницы",
            "en": "As the page"
          }
        },
        {
          "value": "en",
          "label": {
            "ru": "Английский",
            "en": "English"
          }
        },
        {
          "value": "ru",
          "label": {
            "ru": "Русский",
            "en": "Russian"
          }
        }
      ],
      "hint": {
        "ru": "Для варианта «Слова»",
        "en": "For «Words»"
      }
    },
    {
      "key": "size",
      "type": "integer",
      "label": {
        "ru": "Размер знака",
        "en": "Glyph size"
      },
      "default": 14,
      "min": 10,
      "max": 24,
      "unit": "px"
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Знаки светлеют у указателя",
        "en": "Glyphs light up near the pointer"
      }
    }
