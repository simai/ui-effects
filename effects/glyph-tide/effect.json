{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "glyph-tide",
  "version": "1.1.0",
  "label": {
    "ru": "Знаковый прилив",
    "en": "Glyph tide"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section",
    "dashboard"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 55,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "hint": {
        "ru": "Доля заполненных ячеек",
        "en": "Share of filled cells"
      }
    },
    {
      "key": "charset",
      "type": "choice",
      "label": {
        "ru": "Набор знаков",
        "en": "Characters"
      },
      "default": "hex",
      "options": [
        {
          "value": "hex",
          "label": {
            "ru": "Шестнадцатеричные",
            "en": "Hexadecimal"
          }
        },
        {
          "value": "binary",
          "label": {
            "ru": "Двоичные",
            "en": "Binary"
          }
        },
        {
          "value": "digits",
          "label": {
            "ru": "Цифры",
            "en": "Digits"
          }
        },
        {
          "value": "symbols",
          "label": {
            "ru": "Символы",
            "en": "Symbols"
          }
        }
      ]
    },
    {
      "key": "size",
      "type": "integer",
      "label": {
        "ru": "Размер знака",
        "en": "Glyph size"
      },
      "default": 14,
      "min": 10,
      "max": 24,
      "unit": "px"
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Знаки светлеют у указателя",
        "en": "Glyphs light up near the pointer"
      }
    }
  ],
  "needs": {
    "network": false
  }
}
