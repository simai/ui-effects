{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "liquid-chrome",
  "version": "1.1.0",
  "label": {
    "ru": "Жидкий металл",
    "en": "Liquid metal"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section"
  ],
  "schemes": [
    "dark"
  ],
  "pair": "paper-facets",
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость отражений",
        "en": "Reflection brightness"
      },
      "default": 55,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "scale",
      "type": "integer",
      "label": {
        "ru": "Размер волн",
        "en": "Wave size"
      },
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1,
      "hint": {
        "ru": "1 — крупные складки, 5 — мелкая рябь",
        "en": "1 is broad folds, 5 is fine ripples"
      }
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Указатель продавливает мягкую вмятину",
        "en": "The pointer presses a soft dent"
      }
    }
  ],
  "needs": {
    "network": false
  }
}
