{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "particle-shapes",
  "version": "0.1.0",
  "label": {
    "ru": "Узор частиц",
    "en": "Particle text"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "section",
    "dashboard",
    "sign-in"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость",
        "en": "Intensity"
      },
      "default": 70,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "size",
      "type": "integer",
      "label": {
        "ru": "Размер текста",
        "en": "Text size"
      },
      "default": 100,
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "hint": {
        "ru": "100 % — текст по размеру области",
        "en": "100 % fits the text to the area"
      }
    },
    {
      "key": "text",
      "type": "text",
      "label": {
        "ru": "Текст",
        "en": "Text"
      },
      "default": "SIMAI",
      "max": 80,
      "hint": {
        "ru": "До четырёх строк",
        "en": "Up to four lines"
      }
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Клик рассыпает часть текста, удержание закручивает вихрь",
        "en": "A click scatters part of the text, holding whirls it"
      }
    }
  ],
  "needs": {
    "network": false
  }
}
