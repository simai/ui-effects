    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer",
        "es": "Reaccionar al puntero",
        "pt-BR": "Reagir ao ponteiro",
        "de": "Auf den Zeiger reagieren",
        "zh-CN": "响应指针",
        "fr": "Réagir au pointeur",
        "ja": "ポインターに反応"
      },
      "default": true,
      "hint": {
        "ru": "Записи рядом с указателем расступаются; щелчок сразу переключает на следующее представление",
        "en": "Records near the pointer move aside; a click switches to the next view at once",
        "es": "Los registros cerca del puntero se apartan; un clic cambia de inmediato a la vista siguiente",
        "pt-BR": "Os registros perto do ponteiro se afastam; um clique muda na hora para a próxima visualização",
        "de": "Datensätze in der Nähe des Zeigers weichen aus; ein Klick wechselt sofort zur nächsten Ansicht",
        "zh-CN": "指针附近的记录会让开；点击会立即切换到下一个视图",
        "fr": "Les enregistrements proches du pointeur s’écartent ; un clic passe aussitôt à la vue suivante",
        "ja": "ポインターの近くのレコードはよけます。クリックするとすぐ次のビューに切り替わります"
