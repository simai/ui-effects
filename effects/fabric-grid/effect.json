{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "fabric-grid",
  "version": "0.3.0",
  "label": {
    "ru": "Ткань пространства-времени",
    "en": "Spacetime fabric"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "section",
    "dashboard",
    "sign-in"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость",
        "en": "Intensity"
      },
      "default": 70,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "palette",
      "type": "choice",
      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": {
            "ru": "Цвет темы",
            "en": "Theme colour"
          }
        },
        {
          "value": "turquoise",
          "label": {
            "ru": "Бирюзовая",
            "en": "Turquoise"
          }
        },
        {
          "value": "ocean",
          "label": {
            "ru": "Океан",
            "en": "Ocean"
          }
        },
        {
          "value": "violet",
          "label": {
            "ru": "Фиолетовая",
            "en": "Violet"
          }
        },
        {
          "value": "rose",
          "label": {
            "ru": "Роза",
            "en": "Rose"
          }
        },
        {
          "value": "emerald",
          "label": {
            "ru": "Изумруд",
            "en": "Emerald"
          }
        },
        {
          "value": "sunset",
          "label": {
            "ru": "Закат",
            "en": "Sunset"
          }
        },
        {
          "value": "gold",
          "label": {
            "ru": "Золото",
            "en": "Gold"
          }
        },
        {
          "value": "silver",
          "label": {
            "ru": "Серебро",
            "en": "Silver"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой цвет",
            "en": "Custom colour"
          }
        }
      ]
    },
    {
      "key": "colour",
      "type": "color",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "#3b82f6",
      "hint": {
        "ru": "Для палитры «Свой цвет»: эффект строит все оттенки из него",
        "en": "For the custom colour palette: the effect builds every tone from it"
      }
    },
    {
      "key": "bodies",
      "type": "boolean",
      "label": {
        "ru": "Пролетающие тела",
        "en": "Passing bodies"
      },
      "default": true,
      "hint": {
        "ru": "Время от времени по дуге пролетают планеты и звёзды разной массы, иногда большое тяжёлое тело; каждое прогибает сетку",
        "en": "Now and then planets and stars of different masses pass along an arc, a big heavy one from time to time; each bends the grid"
      }
    },
    {
      "key": "frequency",
      "type": "choice",
      "label": {
        "ru": "Как часто пролетают тела",
        "en": "How often bodies pass"
      },
      "default": "normal",
      "options": [
        {
          "value": "rare",
          "label": {
            "ru": "Редко",
            "en": "Rarely"
          }
        },
        {
          "value": "normal",
          "label": {
            "ru": "Обычно",
            "en": "Normal"
          }
        },
        {
          "value": "often",
          "label": {
            "ru": "Часто",
            "en": "Often"
          }
        }
      ],
      "hint": {
        "ru": "Одновременно в кадре не больше двух тел",
        "en": "No more than two bodies in view at once"
      }
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Клик пускает гравитационную волну. Нажатие кладёт звезду: чем дольше держите, тем она тяжелее. Отпущенная звезда растёт, вспыхивает, сжимается в чёрную дыру, а та через несколько секунд испаряется",
        "en": "A click sends a gravitational wave. A press sets down a star that grows heavier while held; let go, and it grows, flares, collapses into a black hole and evaporates a few seconds later"
      }
    }
  ],
  "needs": {
    "network": false
  }
