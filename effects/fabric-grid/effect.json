{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "fabric-grid",
  "version": "0.4.0",
  "label": {
    "ru": "Ткань пространства-времени",
    "en": "Spacetime fabric"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "section",
    "dashboard",
    "sign-in"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость",
        "en": "Intensity"
      },
      "default": 70,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density"
      },
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "palette",
      "type": "choice",
      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": {
            "ru": "Цвет темы",
            "en": "Theme colour"
          }
        },
        {
          "value": "turquoise",
          "label": {
            "ru": "Бирюзовая",
            "en": "Turquoise"
          }
        },
        {
          "value": "ocean",
          "label": {
            "ru": "Океан",
            "en": "Ocean"
          }
        },
        {
          "value": "violet",
          "label": {
            "ru": "Фиолетовая",
            "en": "Violet"
          }
        },
        {
          "value": "rose",
          "label": {
            "ru": "Роза",
            "en": "Rose"
          }
        },
        {
          "value": "emerald",
          "label": {
            "ru": "Изумруд",
            "en": "Emerald"
          }
        },
        {
          "value": "sunset",
          "label": {
            "ru": "Закат",
            "en": "Sunset"
          }
        },
        {
          "value": "gold",
          "label": {
            "ru": "Золото",
            "en": "Gold"
          }
        },
        {
          "value": "silver",
          "label": {
            "ru": "Серебро",
            "en": "Silver"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой цвет",
            "en": "Custom colour"
          }
        }
      ]
    },
    {
      "key": "colour",
      "type": "color",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "#3b82f6",
      "hint": {
        "ru": "Эффект строит из него все оттенки",
        "en": "The effect builds every tone from it"
      },
      "when": {
        "key": "palette",
        "is": [
          "custom"
        ]
      }
    },
    {
      "key": "bodies",
      "type": "boolean",
      "label": {
        "ru": "Пролетающие тела",
        "en": "Passing bodies"
      },
      "default": true,
      "hint": {
        "ru": "Время от времени с края входят планеты и звёзды разной массы, иногда большое тяжёлое тело. Они притягивают друг друга по закону Ньютона, прогибают сетку, а у тяжёлой звезды или чёрной дыры уходят на орбиту",
        "en": "Now and then planets and stars of different masses come in from an edge, a big heavy one from time to time. They attract each other by Newton's law, bend the grid, and fall into orbit around a heavy star or black hole"
      }
    },
    {
      "key": "frequency",
      "type": "choice",
      "label": {
        "ru": "Как часто пролетают тела",
        "en": "How often bodies pass"
      },
      "default": "normal",
      "options": [
        {
          "value": "rare",
          "label": {
            "ru": "Редко",
            "en": "Rarely"
          }
        },
        {
          "value": "normal",
          "label": {
            "ru": "Обычно",
            "en": "Normal"
          }
        },
        {
          "value": "often",
          "label": {
            "ru": "Часто",
            "en": "Often"
          }
        }
      ],
      "hint": {
        "ru": "Одновременно в кадре не больше трёх тел; пока есть чёрная дыра, следующее тело летит мимо неё",
        "en": "No more than three bodies in view at once; while a black hole is there, the next one heads past it"
      }
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true,
      "hint": {
        "ru": "Клик пускает гравитационную волну. Нажмите и удерживайте: под указателем появляется звезда, растёт, вспыхивает и сжимается в чёрную дыру. Пролетающие тела притягиваются к ней, уходят на орбиту или падают в неё; через полминуты дыра испаряется",
        "en": "A click sends a gravitational wave. Press and hold: a star appears under the pointer, grows, flares and collapses into a black hole. Passing bodies are pulled in, fall into orbit or are swallowed; the black hole evaporates within half a minute"
      }
    }
  ],
  "needs": {
    "network": false
  }
}
