      "hint": {
        "ru": "Эффект строит из него все оттенки",
        "en": "The effect builds every tone from it",
        "es": "El efecto construye todos los tonos a partir de él",
        "pt-BR": "O efeito constrói todos os tons a partir dela",
        "de": "Der Effekt baut daraus jeden Farbton auf",
