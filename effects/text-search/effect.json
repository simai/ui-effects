{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "text-search",
  "version": "0.2.0",
  "label": {
    "ru": "Поиск",
    "en": "Text search",
    "es": "Búsqueda de texto",
    "pt-BR": "Busca de texto",
    "de": "Textsuche",
    "zh-CN": "文本搜索",
    "fr": "Recherche de texte",
    "ja": "テキスト検索"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "section",
    "dashboard",
    "sign-in"
  ],
  "schemes": [
    "light",
    "dark"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed",
        "es": "Velocidad",
        "pt-BR": "Velocidade",
        "de": "Geschwindigkeit",
        "zh-CN": "速度",
        "fr": "Vitesse",
        "ja": "速度"
      },
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Яркость",
        "en": "Intensity",
        "es": "Intensidad",
        "pt-BR": "Intensidade",
        "de": "Intensität",
        "zh-CN": "强度",
        "fr": "Intensité",
        "ja": "強さ"
      },
      "default": 70,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Плотность",
        "en": "Density",
        "es": "Densidad",
        "pt-BR": "Densidade",
        "de": "Dichte",
        "zh-CN": "密度",
        "fr": "Densité",
        "ja": "密度"
      },
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "columns",
      "type": "integer",
      "label": {
        "ru": "Колонки",
        "en": "Columns",
        "es": "Columnas",
        "pt-BR": "Colunas",
        "de": "Spalten",
        "zh-CN": "栏数",
        "fr": "Colonnes",
        "ja": "段数"
      },
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "hint": {
        "ru": "Сколько страниц текста стоит рядом; на узком экране колонок меньше, чтобы каждая оставалась не уже 260 px",
        "en": "How many pages of text stand side by side; narrow screens show fewer so each stays at least 260 px wide",
        "es": "Cuántas páginas de texto se muestran una junto a otra; en pantallas estrechas se muestran menos para que cada una tenga al menos 260 px",
        "pt-BR": "Quantas páginas de texto ficam lado a lado; telas estreitas mostram menos para que cada uma tenha pelo menos 260 px",
        "de": "Wie viele Textseiten nebeneinander stehen; schmale Bildschirme zeigen weniger, damit jede mindestens 260 px breit bleibt",
        "zh-CN": "并排显示几页文字；窄屏会减少栏数，使每栏至少 260 px 宽",
        "fr": "Combien de pages de texte se tiennent côte à côte ; les écrans étroits en montrent moins pour que chacune garde au moins 260 px",
        "ja": "横に並べるテキストのページ数。狭い画面では各段が 260 px 以上になるよう段数を減らします"
      }
    },
    {
      "key": "hits",
      "type": "integer",
      "label": {
        "ru": "Совпадения",
        "en": "Hits",
        "es": "Coincidencias",
        "pt-BR": "Ocorrências",
        "de": "Treffer",
        "zh-CN": "匹配数",
        "fr": "Occurrences",
        "ja": "ヒット数"
