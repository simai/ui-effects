{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "mist-gradient",
  "version": "2.1.0",
  "label": {
    "ru": "Цветная дымка",
    "en": "Colour haze"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "docs",
    "dashboard",
    "product"
  ],
  "schemes": [
    "light",
    "dark"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Насыщенность",
        "en": "Saturation"
      },
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "palette",
      "type": "choice",
      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": {
            "ru": "Цвета темы",
            "en": "Theme colours"
          }
        },
        {
          "value": "warm",
          "label": {
            "ru": "Тёплая",
            "en": "Warm"
          }
        },
        {
          "value": "cool",
          "label": {
            "ru": "Холодная",
            "en": "Cool"
          }
        },
        {
          "value": "mono",
          "label": {
            "ru": "Один цвет",
            "en": "One colour"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой цвет",
            "en": "Custom colour"
          }
        }
      ]
    },
    {
      "key": "colour",
      "type": "color",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "#3b82f6",
      "hint": {
        "ru": "Для палитры «Свой цвет»: эффект строит все оттенки из него",
        "en": "For the custom colour palette: the effect builds every tone from it"
      }
    },
    {
      "key": "grain",
      "type": "boolean",
      "label": {
        "ru": "Зерно бумаги",
        "en": "Paper grain"
      },
      "default": true
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    }
  ],
  "needs": {
    "network": false
  }
}
