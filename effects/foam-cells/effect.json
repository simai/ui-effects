{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "foam-cells",
  "version": "1.0.0",
  "label": {
    "ru": "Пена",
    "en": "Foam cells"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "hero",
    "sign-in",
    "product"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Размер клетки, px",
        "en": "Cell size, px"
      },
      "default": 80,
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Насыщенность",
        "en": "Strength"
      },
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "style",
      "type": "choice",
      "label": {
        "ru": "Рисунок",
        "en": "Style"
      },
      "default": "both",
      "options": [
        {
          "value": "membranes",
          "label": {
            "ru": "Перегородки",
            "en": "Membranes"
          }
        },
        {
          "value": "pebbles",
          "label": {
            "ru": "Галька",
            "en": "Pebbles"
          }
        },
        {
          "value": "both",
          "label": {
            "ru": "Перегородки и галька",
            "en": "Both"
          }
        }
      ]
    },
    {
      "key": "tone",
      "type": "choice",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": {
            "ru": "Основной цвет темы",
            "en": "Theme primary"
          }
        },
        {
          "value": "secondary",
          "label": {
            "ru": "Вторичный цвет темы",
            "en": "Theme secondary"
          }
        },
        {
          "value": "tertiary",
          "label": {
            "ru": "Третичный цвет темы",
            "en": "Theme tertiary"
          }
        },
        {
          "value": "ink",
          "label": {
            "ru": "Цвет текста",
            "en": "Text colour"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    },
    {
      "key": "scheme",
      "type": "choice",
      "label": {
        "ru": "Тема области",
        "en": "Area theme"
      },
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": {
            "ru": "Светлая",
            "en": "Light"
          }
        }
      ],
      "hint": {
        "ru": "Эффект рисует светлый фон в любой теме страницы; область эффекта получает класс theme-light, и текст над ним берёт роли этой темы.",
        "en": "The effect draws a light ground in any page theme; its area takes theme-light, so text over it uses that theme's roles."
      }
    }
  ],
  "needs": {
    "network": false
  }
}
