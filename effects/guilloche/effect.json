{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "guilloche",
  "version": "1.0.0",
  "label": {
    "ru": "Гильош",
    "en": "Guilloche"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "dashboard",
    "product",
    "sign-in"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Число линий",
        "en": "Lines"
      },
      "default": 36,
      "min": 18,
      "max": 72,
      "step": 6
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Насыщенность",
        "en": "Strength"
      },
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "pattern",
      "type": "choice",
      "label": {
        "ru": "Узор",
        "en": "Pattern"
      },
      "default": "mesh",
      "options": [
        {
          "value": "rosettes",
          "label": {
            "ru": "Розетки",
            "en": "Rosettes"
          }
        },
        {
          "value": "bands",
          "label": {
            "ru": "Ленты",
            "en": "Bands"
          }
        },
        {
          "value": "mesh",
          "label": {
            "ru": "Розетки и ленты",
            "en": "Rosettes and bands"
          }
        }
      ]
    },
    {
      "key": "tone",
      "type": "choice",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": {
            "ru": "Основной цвет темы",
            "en": "Theme primary"
          }
        },
        {
          "value": "secondary",
          "label": {
            "ru": "Вторичный цвет темы",
            "en": "Theme secondary"
          }
        },
        {
          "value": "tertiary",
          "label": {
            "ru": "Третичный цвет темы",
            "en": "Theme tertiary"
          }
        },
        {
          "value": "ink",
          "label": {
            "ru": "Цвет текста",
            "en": "Text colour"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    },
    {
      "key": "scheme",
      "type": "choice",
      "label": {
        "ru": "Тема области",
        "en": "Area theme"
      },
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": {
            "ru": "Светлая",
            "en": "Light"
          }
        },
        {
          "value": "dark",
          "label": {
            "ru": "Тёмная",
            "en": "Dark"
          }
        }
      ],
      "hint": {
        "ru": "Схема рисунка; обе нарисованы отдельно из тонов палитры. Хост выбирает её по режиму темы и даёт области theme-dark или theme-light.",
        "en": "The scheme the effect draws in; both are designed from palette tones. The host picks it from the theme mode and gives the area theme-dark or theme-light."
      }
    }
  ],
  "needs": {
    "network": false
  }
}
