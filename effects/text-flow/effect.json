          "label": {
            "ru": "С секретами",
            "en": "With secrets"
          }
        },
        {
          "value": "prose",
          "label": {
            "ru": "Слова",
            "en": "Words"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой текст",
            "en": "Own text"
          }
        },
        {
          "value": "letters",
          "label": {
            "ru": "Буквы и цифры",
            "en": "Letters and digits"
          }
        },
        {
          "value": "hex",
          "label": {
            "ru": "Шестнадцатеричные",
            "en": "Hexadecimal"
          }
        },
        {
          "value": "binary",
          "label": {
            "ru": "Двоичные",
            "en": "Binary"
          }
        },
        {
          "value": "digits",
          "label": {
            "ru": "Цифры",
            "en": "Digits"
          }
        },
        {
          "value": "signs",
          "label": {
            "ru": "Знаки",
            "en": "Signs"
          }
        }
      ]
    },
    {
      "key": "text",
      "type": "text",
      "label": {
        "ru": "Свой текст",
        "en": "Own text"
      },
      "default": "",
      "max": 600,
      "hint": {
        "ru": "Для варианта «Свой текст»: фразы через точку или с новой строки",
        "en": "For «Own text»: sentences, or one per line"
      }
    },
    {
      "key": "language",
      "type": "choice",
      "label": {
        "ru": "Язык слов",
        "en": "Words language"
      },
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "ru": "Как у страницы",
            "en": "As the page"
          }
        },
        {
          "value": "en",
          "label": {
            "ru": "Английский",
            "en": "English"
          }
        },
        {
          "value": "ru",
          "label": {
            "ru": "Русский",
            "en": "Russian"
          }
        }
      ],
      "hint": {
        "ru": "Для варианта «Слова»",
        "en": "For «Words»"
      }
