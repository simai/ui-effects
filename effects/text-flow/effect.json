      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": {
            "ru": "Цвет темы",
            "en": "Theme colour"
          }
        },
        {
          "value": "turquoise",
          "label": {
            "ru": "Бирюзовая",
            "en": "Turquoise"
          }
        },
        {
          "value": "ocean",
          "label": {
            "ru": "Океан",
            "en": "Ocean"
          }
        },
        {
          "value": "violet",
          "label": {
            "ru": "Фиолетовая",
            "en": "Violet"
          }
        },
        {
          "value": "rose",
          "label": {
            "ru": "Роза",
            "en": "Rose"
          }
        },
        {
          "value": "emerald",
          "label": {
            "ru": "Изумруд",
            "en": "Emerald"
          }
        },
        {
          "value": "sunset",
          "label": {
            "ru": "Закат",
            "en": "Sunset"
          }
        },
        {
          "value": "gold",
          "label": {
            "ru": "Золото",
            "en": "Gold"
          }
        },
        {
          "value": "silver",
          "label": {
            "ru": "Серебро",
            "en": "Silver"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Свой цвет",
            "en": "Custom colour"
          }
        }
      ]
    },
    {
      "key": "colour",
      "type": "color",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "#3b82f6",
      "hint": {
        "ru": "Для палитры «Свой цвет»: эффект строит все оттенки из него",
        "en": "For the custom colour palette: the effect builds every tone from it"
      }
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Волна по клику",
        "en": "Wave on click"
      },
      "default": true,
      "hint": {
        "ru": "Щелчок в области запускает волну света",
        "en": "A click in the area sends a wave of light"
      }
