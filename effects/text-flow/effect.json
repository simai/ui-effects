{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "text-flow",
  "version": "3.2.0",
  "label": {
    "ru": "Текстовый поток",
    "en": "Text flow"
  },
  "author": "Rim Zabarov / SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section",
    "dashboard"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Свет",
        "en": "Light"
      },
      "default": 52,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "hint": {
        "ru": "Яркость световых складок",
        "en": "Brightness of the folds of light"
      }
    },
    {
      "key": "theme",
      "type": "choice",
      "label": {
        "ru": "Текст",
        "en": "Text"
      },
      "default": "javascript",
      "options": [
        {
          "value": "javascript",
          "label": {
            "ru": "JavaScript",
            "en": "JavaScript"
          }
        },
        {
          "value": "html",
          "label": {
            "ru": "HTML и CSS",
            "en": "HTML and CSS"
          }
        },
        {
          "value": "terminal",
          "label": {
            "ru": "Терминал",
            "en": "Terminal"
          }
        },
        {
