  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "section",
    "dashboard"
  ],
  "schemes": [
    "dark",
    "light"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость",
        "en": "Speed"
