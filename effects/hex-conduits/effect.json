      "default": 50,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "hint": {
        "ru": "Сколько импульсов в решётке",
        "en": "How many pulses run"
      }
    },
    {
      "key": "cell",
      "type": "integer",
      "label": {
        "ru": "Размер ячейки",
        "en": "Cell size"
      },
      "default": 44,
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px"
    },
    {
      "key": "interactive",
