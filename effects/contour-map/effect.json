{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "contour-map",
  "version": "1.2.0",
  "label": {
    "ru": "Горизонтали",
    "en": "Contour map"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "dashboard",
    "docs",
    "hero"
  ],
  "schemes": [
    "light",
    "dark"
  ],
  "capabilities": [
    "windows"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Число уровней",
        "en": "Levels"
      },
      "default": 14,
      "min": 6,
      "max": 30
    },
    {
      "key": "lineWeight",
      "type": "number",
      "label": {
        "ru": "Толщина линии, px",
        "en": "Line weight, px"
      },
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.25,
      "unit": "px"
    },
    {
      "key": "tone",
      "type": "choice",
      "label": {
        "ru": "Цвет",
        "en": "Colour"
      },
      "default": "ink",
      "options": [
        {
          "value": "primary",
          "label": {
            "ru": "Основной цвет темы",
            "en": "Theme primary"
          }
        },
        {
          "value": "secondary",
          "label": {
            "ru": "Вторичный цвет темы",
            "en": "Theme secondary"
          }
        },
        {
          "value": "tertiary",
          "label": {
            "ru": "Третичный цвет темы",
            "en": "Theme tertiary"
          }
        },
        {
          "value": "ink",
          "label": {
            "ru": "Цвет текста",
            "en": "Text colour"
          }
        }
      ]
    },
    {
      "key": "palette",
      "type": "choice",
      "label": {
        "ru": "Палитра",
        "en": "Palette"
      },
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": {
            "ru": "Цвет темы",
            "en": "Theme colour"
          }
        },
        {
          "value": "turquoise",
          "label": {
            "ru": "Бирюзовая",
            "en": "Turquoise"
          }
        },
        {
          "value": "ocean",
          "label": {
            "ru": "Океан",
            "en": "Ocean"
          }
        },
        {
          "value": "violet",
          "label": {
            "ru": "Фиолетовая",
            "en": "Violet"
          }
        },
        {
          "value": "rose",
          "label": {
            "ru": "Роза",
            "en": "Rose"
          }
        },
        {
          "value": "emerald",
          "label": {
            "ru": "Изумруд",
            "en": "Emerald"
          }
        },
        {
          "value": "sunset",
          "label": {
            "ru": "Закат",
            "en": "Sunset"
          }
        },
        {
          "value": "gold",
          "label": {
            "ru": "Золото",
            "en": "Gold"
          }
        },
        {
          "value": "silver",
          "label": {
            "ru": "Серебро",
            "en": "Silver"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    }
  ],
  "needs": {
    "network": false
  }
}
