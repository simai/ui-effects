{
  "schema": "simai.effect",
  "schema_version": 1,
  "id": "leaf-shadows",
  "version": "1.0.0",
  "label": {
    "ru": "Тень листвы",
    "en": "Leaf shadows"
  },
  "author": "SIMAI",
  "entry": "index.js",
  "preview": "preview.png",
  "surfaces": [
    "sign-in",
    "hero",
    "product"
  ],
  "settings": [
    {
      "key": "speed",
      "type": "integer",
      "label": {
        "ru": "Скорость, %",
        "en": "Speed, %"
      },
      "default": 100,
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "key": "intensity",
      "type": "integer",
      "label": {
        "ru": "Глубина тени",
        "en": "Shadow depth"
      },
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "density",
      "type": "integer",
      "label": {
        "ru": "Густота листвы, %",
        "en": "Foliage, %"
      },
      "default": 55,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "daytime",
      "type": "choice",
      "label": {
        "ru": "Время дня",
        "en": "Time of day"
      },
      "default": "morning",
      "options": [
        {
          "value": "morning",
          "label": {
            "ru": "Утро",
            "en": "Morning"
          }
        },
        {
          "value": "noon",
          "label": {
            "ru": "Полдень",
            "en": "Noon"
          }
        },
        {
          "value": "evening",
          "label": {
            "ru": "Вечер",
            "en": "Evening"
          }
        }
      ]
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": {
        "ru": "Реагировать на указатель",
        "en": "React to the pointer"
      },
      "default": true
    },
    {
      "key": "scheme",
      "type": "choice",
      "label": {
        "ru": "Тема области",
        "en": "Area theme"
      },
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": {
            "ru": "Светлая",
            "en": "Light"
          }
        }
      ],
      "hint": {
        "ru": "Эффект рисует светлый фон в любой теме страницы; область эффекта получает класс theme-light, и текст над ним берёт роли этой темы.",
        "en": "The effect draws a light ground in any page theme; its area takes theme-light, so text over it uses that theme's roles."
      }
    }
  ],
  "needs": {
    "network": false
  }
}
