{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simai/ui-effects/blob/main/catalogue/categories.schema.json",
  "title": "simai/ui-effects categories",
  "description": "catalogue/categories.json: the closed set of subjects effects are filed under, with their names in every site language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "categories"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "simai.ui-effects.categories"},
    "version": {"const": 1},
    "note": {"type": "string"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "hint"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z-]{1,20}$"},
          "label": {"type": "object", "required": ["ru", "en"], "additionalProperties": {"type": "string", "minLength": 1}},
          "hint": {"type": "object", "required": ["ru", "en"], "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
