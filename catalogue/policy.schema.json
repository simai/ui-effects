{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simai/ui-effects/blob/main/catalogue/policy.schema.json",
  "title": "simai/ui-effects theme policy sidecar",
  "description": "effects/policy.json: the catalogue order, each effect's categories, its descriptions and roles in every site language, and tags. Schemes, pair and capabilities are in the manifests (simai.effect 1.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "effects"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "simai.ui-effects.policy"},
    "version": {"const": 3},
    "note": {"type": "string"},
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categories", "description", "role", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
          "categories": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z-]{1,20}$"}},
          "description": {"type": "object", "required": ["ru", "en"], "additionalProperties": {"type": "string", "minLength": 1}},
          "role": {"type": "object", "required": ["ru", "en"], "additionalProperties": {"type": "string", "minLength": 1}},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z-]*$"}}
        }
      }
    }
  }
}
